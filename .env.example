# Backend-2: notificaciones + carrito + envíos (EC2 10.0.146.240).
# Los secretos reales viven SOLO en el servidor, nunca en git.

# Orígenes CORS (el Gateway del frontend primero).
FRONTEND_ORIGIN=https://TU-FRONTEND-API.execute-api.us-east-1.amazonaws.com,http://localhost:5173

# Azure AD / Entra ID (mismo tenant y API que backend-1).
AZURE_TENANT_ID=TU-TENANT-ID
AZURE_API_AUDIENCE=api://TU-API-CLIENT-ID,TU-API-CLIENT-ID

# Kafka del backend-3 (IP privada, misma VPC).
KAFKA_BOOTSTRAP_SERVERS=10.0.1.13:29092

# SMTP de notificaciones (vacío = modo simulado, solo log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@summitlab.cl

# Heaps chicos: el host es t3.small compartido por 3 JVM.
JAVA_OPTS_NOTIFICACIONES=-Xms96m -Xmx256m
JAVA_OPTS_CARRITO=-Xms96m -Xmx256m
JAVA_OPTS_ENVIOS=-Xms96m -Xmx256m
